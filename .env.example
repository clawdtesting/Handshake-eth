NEXT_PUBLIC_APP_NAME=Handshake
# Ethereum mainnet RPC URLs (never commit credentials)
# NEXT_PUBLIC values are shipped to browsers: use a domain-restricted key.
NEXT_PUBLIC_ETH_MAINNET_RPC_URL=
# Server-only key for API routes and operational scripts.
ETH_MAINNET_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Ethereum Mainnet deployment: not yet deployed — TBD
NEXT_PUBLIC_SETTLEMENT_CONTRACT_ADDRESS=
HANDSHAKE_ADDRESS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required in production. Vercel Cron uses it as the Authorization bearer token.
CRON_SECRET=
# Optional independent signing key; otherwise derived from the service-role key.
ROOM_SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NFT_PROVIDER=alchemy
ALCHEMY_API_KEY=
OPENSEA_API_KEY=
OPENSEA_CHAIN=ethereum
PRIVATE_KEY_DEPLOYER=
FEE_RECIPIENT_ADDRESS=
CONTRACT_OWNER=
