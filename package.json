{
  "name": "ethereum-market",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vvv",
    "contracts:deploy": "forge script contracts/script/Deploy.s.sol:Deploy --root contracts --rpc-url $ETH_MAINNET_RPC_URL --broadcast",
    "verify:allowlist": "node scripts/verify-allowlist.mjs",
    "contracts:verify": "node scripts/verify-contract.mjs",
    "watch:collections": "node scripts/watch-collections.mjs",
    "reconcile:offers": "node scripts/reconcile-offers.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@rainbow-me/rainbowkit": "^2.2.1",
    "@supabase/supabase-js": "^2.47.10",
    "@tanstack/react-query": "^5.62.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "viem": "^2.21.57",
    "wagmi": "^2.14.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
